{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [12, 16],
  "background": "canvas",
  "terminal_padding": [14, 12],
  "terminal_menu": "wf-term-menu",
  "toast": "wf-toast",
  "preview": "layouts/workflow.svg",
  "divider": { "width": 1, "color": "border" },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": { "px": 320 },
      "min": 44,
      "max": 520,
      "background": "chrome",
      "resizable": true,
      "children": [
        { "id": "brand", "type": "block", "size": { "px": 44 }, "window_drag": true, "content": { "mod": "workspace-chrome" } },
        { "id": "projects", "type": "block", "size": { "weight": 1 }, "min": 120, "content": { "mod": "wf-sidebar" } }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        { "id": "tabs", "type": "block", "size": { "px": 42 }, "window_drag": true, "content": { "mod": "wf-tabs" } },
        {
          "id": "work-body",
          "type": "row",
          "padding": 8,
          "gap": 8,
          "children": [
            {
              "id": "main-stack",
              "type": "stack",
              "active": "active-tab",
              "children": [
                {
                  "id": "active-tab",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "gap": 8,
                      "radius": 10,
                      "background": "background",
                      "lone": true,
                      "border": { "width": 1, "color": "border" },
                      "focus": { "width": 1, "color": "accent" },
                      "header": { "content": { "mod": "pane" }, "height": 30, "position": "top", "reveal": "always" }
                    }
                  }
                },
                {
                  "id": "empty",
                  "type": "block",
                  "content": { "mod": "wf-empty" }
                }
              ]
            },
            {
              "id": "panel",
              "type": "column",
              "size": { "px": 340 },
              "min": 240,
              "max": 900,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    { "id": "files", "type": "block", "content": { "mod": "wf-files" } },
                    { "id": "changes", "type": "block", "content": { "mod": "wf-changes" } }
                  ]
                }
              ]
            }
          ]
        },
        { "id": "status", "type": "block", "size": { "px": 28 }, "content": { "mod": "wf-status" } }
      ]
    }
  ]
}
